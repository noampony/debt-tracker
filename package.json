{
  "name": "debt-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "prisma generate && tsc -b && vite build",
    "preview": "vite preview",
    "start:server": "NODE_ENV=production tsx server/index.ts",
    "lint": "eslint .",
    "format": "prettier --check package.json index.html tsconfig*.json vite.config.ts eslint.config.js src",
    "format:write": "prettier --write package.json index.html tsconfig*.json vite.config.ts eslint.config.js src",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:encode-fields": "tsx scripts/migrate-encode-fields.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
