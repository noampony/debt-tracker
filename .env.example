# Copy this file to .env and fill in your values

# PostgreSQL database for local development.
# Use a development/preview database, not the production database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Dedicated PostgreSQL database used by server tests.
# Tests delete rows, so never point this at production.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_TEST?sslmode=require"

# Optional dedicated PostgreSQL database used by Playwright E2E tests.
# If omitted, E2E setup falls back to TEST_DATABASE_URL.
E2E_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_E2E?sslmode=require"

# Generate a strong random secret (e.g.: openssl rand -hex 32)
JWT_SECRET="replace-with-a-long-random-secret"

# Local standalone Express server port (not used by Vercel Functions)
PORT=3001
